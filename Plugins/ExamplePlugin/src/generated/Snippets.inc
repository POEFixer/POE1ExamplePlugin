{ "textures", "src/lessons/Textures.cpp", "TextureSet::AnimatePlasma()", 83,
R"p1snip(// Animates the plasma by rewriting ONE band of rows per call: a partial
// Texture::Update of 128 x 32 pixels (16 KiB) instead of the whole 64 KiB.
// The app uploads at most about 2 MiB per rendered frame across all plugins,
// so small updates reach the screen sooner. Plugin thread only.
void TextureSet::AnimatePlasma(double seconds) {
    if (!plasma.id || m_plasma.size() != size_t(kPlasmaSize) * kPlasmaSize) return;
    const int y0 = m_band * kPlasmaBand;
    const float t = static_cast<float>(std::fmod(seconds, 1000.0));
    for (int y = y0; y < y0 + kPlasmaBand; ++y)
        for (int x = 0; x < kPlasmaSize; ++x) m_plasma[size_t(y) * kPlasmaSize + size_t(x)] = PlasmaPixel(x, y, t);
    const uint32_t* band = m_plasma.data() + size_t(y0) * kPlasmaSize;
    // Update(texture, x, y, w, h, pixels, pitch): pitch is the source row length in BYTES.
    if (p1::Texture::Update(plasma.id, 0, y0, kPlasmaSize, kPlasmaBand, band, kPlasmaSize * 4)) ++updates;
    else ++refused;
    m_band = (m_band + 1) % (kPlasmaSize / kPlasmaBand);
})p1snip" },
{ "threads", "src/lessons/Threads.cpp", "Worker::Loop()", 55,
R"p1snip(// The worker's loop. The rules for every thread a plugin starts:
//  1. wait on a condition variable, never spin, and check `stop` after every
//     wake (Stop() sets it and notifies, so this wait needs no time-out);
//  2. never run a job while holding the lock;
//  3. touch nothing of the plugin's: a job returns a Done, and the plugin thread
//     runs it in Drain(), where no lock is needed any more;
//  4. catch EVERYTHING: an exception that leaves a thread is std::terminate,
//     a crash of the whole plugin (Run() wraps this loop in try / catch);
//  5. a failure comes back too (Failed), or a "busy" flag would wait forever.
void Worker::Loop(Shared& sh) {
    std::unique_lock lock(sh.mutex);
    while (!sh.stop) {
        if (sh.queue.empty()) {
            sh.wake.wait(lock);
            continue;
        }
        Shared::Item item = std::move(sh.queue.front());
        sh.queue.pop_front();
        sh.stats.current = item.name;
        lock.unlock();
        const auto t0 = std::chrono::steady_clock::now();
        Done done;
        std::string error;
        try {
            done = item.job();
        } catch (const std::exception& e) {
            error = e.what();
        } catch (...) {
            error = "unknown exception";
        }
        if (!error.empty() && item.failed)
            done = [failed = std::move(item.failed), error](App& app) { failed(app, error); };
        const float ms = std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - t0).count();
        lock.lock();
        sh.stats.current.clear();
        sh.stats.lastName = std::move(item.name);
        sh.stats.lastJobMs = ms;
        if (error.empty()) ++sh.stats.done;
        else { ++sh.stats.failed; sh.stats.lastError = error; }
        if (done) sh.outbox.push_back(std::move(done));
    }
})p1snip" },
{ "w2s", "src/lessons/WorldToScreen.cpp", "DrawGrid()", 28,
R"p1snip(// A 5 x 5 grid on the ground around `centre`. A straight line in the world is a
// straight line on screen, so projecting both ends of each line is enough. A
// line with an end behind the camera is skipped (WorldToScreen returns false).
void DrawGrid(ImDrawList* dl, const P1Frame& f, P1Vec3 centre, float cell, ImU32 col) {
    if (!(cell >= 1.0f)) return;                     // a typed 0 (or NaN) would divide by zero
    centre.x = std::round(centre.x / cell) * cell;   // snapped: the grid stays put in the world
    centre.y = std::round(centre.y / cell) * cell;
    const float half = cell * 2.5f;
    for (int i = 0; i <= 5; ++i) {
        const float o = -half + cell * float(i);
        ImVec2 a, b;
        if (p1::WorldToScreen(f, centre.x + o, centre.y - half, centre.z, a) &&
            p1::WorldToScreen(f, centre.x + o, centre.y + half, centre.z, b))
            dl->AddLine(a, b, col, 1.0f);
        if (p1::WorldToScreen(f, centre.x - half, centre.y + o, centre.z, a) &&
            p1::WorldToScreen(f, centre.x + half, centre.y + o, centre.z, b))
            dl->AddLine(a, b, col, 1.0f);
    }
})p1snip" },
{ "widgets", "src/lessons/Widgets.cpp", "DrawReferenceForm()", 41,
R"p1snip(// A settings form, the recommended way: a measured label column (no width
// typed for English text), one control per row filling the value column, a
// (?) where a setting needs explaining, and every change marked dirty so the
// plugin saves it 1 s later.
bool DrawReferenceForm(Form& form) {
    bool changed = false;
    if (ui::BeginForm("form", { "Enabled", "Mode", "Radius", "Colour", "Label" })) {
        ui::FormRow("Enabled");
        changed |= ImGui::Checkbox("##enabled", &form.enabled);
        ImGui::BeginDisabled(!form.enabled);   // dependent rows stay visible, greyed out
        ui::FormRow("Mode", "Gentle draws only rare and unique monsters; Aggressive draws all of them.");
        changed |= ImGui::Combo("##mode", &form.mode, kModes, IM_ARRAYSIZE(kModes));
        // Ctrl+click types any number: AlwaysClamp keeps a typed value inside the range too.
        ui::FormRow("Radius", "In world units: about 10.9 per grid cell. Ctrl+click to type a value "
                              "(kept within 10 to 300).");
        changed |= ImGui::SliderFloat("##radius", &form.radius, 10.0f, 300.0f, "%.0f", ImGuiSliderFlags_AlwaysClamp);
        ui::FormRow("Colour");
        changed |= ImGui::ColorEdit4("##colour", &form.colour.x, ImGuiColorEditFlags_AlphaBar);
        ui::FormRow("Label", "Any language: the text is UTF-8 end to end.");
        changed |= ImGui::InputText("##label", form.label, sizeof form.label);
        ImGui::EndDisabled();
        ui::EndForm();
    }
    return changed;
})p1snip" },
