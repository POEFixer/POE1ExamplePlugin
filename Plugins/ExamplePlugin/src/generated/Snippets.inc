{ "memory", "src/lessons/Memory.cpp", "CheckPeHeader()", 44,
R"p1snip(// A read that survives every game patch: the PE headers at the module base.
// "MZ" at offset 0, e_lfanew at 0x3C, "PE\0\0" at e_lfanew. None of this is an
// offset into a game object, so none of it rots. Check what you read before
// you follow it: e_lfanew comes from another process's memory.
PeInfo CheckPeHeader(uint64_t moduleBase) {
    PeInfo r;
    IMAGE_DOS_HEADER dos{};
    if (!moduleBase || !p1::Memory::Read(moduleBase, dos)) return r;     // all 64 bytes, or false
    r.read = true;
    r.mz = dos.e_magic == IMAGE_DOS_SIGNATURE;                            // 'MZ'
    if (!r.mz || dos.e_lfanew <= 0 || dos.e_lfanew > 4096) return r;
    IMAGE_NT_HEADERS64 nt{};
    if (!p1::Memory::Read(moduleBase + uint64_t(dos.e_lfanew), nt)) return r;
    r.pe = nt.Signature == IMAGE_NT_SIGNATURE;                            // 'PE\0\0'
    r.machine = nt.FileHeader.Machine;                                    // 0x8664 = x64
    r.sections = nt.FileHeader.NumberOfSections;
    r.timestamp = nt.FileHeader.TimeDateStamp;                            // link time: changes per game build
    r.imageSize = nt.OptionalHeader.SizeOfImage;
    return r;
})p1snip" },
{ "overlay", "src/lessons/Overlay.cpp", "DrawMarkers()", 53,
R"p1snip(// Markers: project each monster's world position to client pixels, draw a
// circle there. WorldToScreen returns false behind the camera: skip those.
// Pixel sizes follow the app's UI scale; colours carry the rarity.
void DrawMarkers(ImDrawList* dl, const P1Frame& f, const LayerState& layer) {
    const float r = layer.size * UiScale(f);
    const ImU32 normal = ImGui::ColorConvertFloat4ToU32(layer.color);
    for (const P1Entity& e : p1::Entities(*f.snapshot)) {
        // Living hostile monsters: reaction 1 is friendly, 0xFF means none was read.
        if (e.kind != P1_KIND_MONSTER || !e.has_life || e.hp <= 0 || e.reaction == 1 || e.reaction == 0xFF) continue;
        ImVec2 p;
        if (!p1::WorldToScreen(f, e.render_pos, p)) continue;
        const bool rarityColour = e.rarity >= 1 && e.rarity <= 3;   // magic, rare, unique
        const ImU32 col = rarityColour ? ImGui::ColorConvertFloat4ToU32(ui::RarityColor(e.rarity)) : normal;
        dl->AddCircleFilled(p, r * 0.35f, col);
        dl->AddCircle(p, e.rarity == 3 ? r * 1.3f : r, col, 0, e.rarity >= 2 ? 2.5f : 1.5f);
    }
})p1snip" },
{ "performance", "src/lessons/Performance.cpp", "DrawStress()", 45,
R"p1snip(// The stress test: `count` small hexagons over the screen, in ONE draw call
// (same texture, same clip rectangle) while the window's draw list stays under
// 65,536 vertices (16-bit indices; past that a new command starts). 6 points
// each: 12 vertices and 48 indices with anti-aliasing, so 5000 stay under the
// overlay's 150,000 vertices and 300,000 indices. Big overlapping shapes would
// cost fill instead.
void DrawStress(ImDrawList* dl, ImVec2 client, int count, float now) {
    const ImVec2 c(client.x * 0.5f, client.y * 0.5f);
    const float spread = (std::min)(client.x, client.y) * 0.46f / std::sqrt(float(kStressMax));
    for (int i = 0; i < count; ++i) {
        const float a = float(i) * 2.39996323f + now * 0.2f;      // the golden angle: an even spiral
        const float r = spread * std::sqrt(float(i));
        const ImVec2 p(c.x + std::cos(a) * r, c.y + std::sin(a) * r);
        dl->AddCircleFilled(p, 3.0f, IM_COL32(120, 200, 255, 160), 6);
    }
})p1snip" },
{ "player", "src/lessons/Player.cpp", "MakeVital()", 33,
R"p1snip(// Life with its reservation. A fraction is in 1/10000 of the maximum; values
// out of range read as "none" (a bad read after a game patch must not turn
// into a negative pool).
Vital MakeVital(int current, int max, int reservedFlat, int reservedFraction) {
    Vital v;
    v.current = std::max(0, current);
    v.max = std::max(0, max);
    const int64_t fraction = (reservedFraction >= 0 && reservedFraction <= 10000) ? reservedFraction : 0;
    const int64_t flat = (reservedFlat >= 0 && reservedFlat <= v.max) ? reservedFlat : 0;
    const int64_t reserved = (fraction * v.max + 9999) / 10000 + flat;   // the fraction rounds up
    v.reserved = static_cast<int>(std::min<int64_t>(reserved, v.max));
    return v;
})p1snip" },
{ "settings", "src/Plugin.cpp", "ReadSettings()", 103,
R"p1snip(// Read the file (any thread: OnLoad, or the worker for a reload), then apply
// it on the plugin thread. Every LoadResult needs its own answer:
//   Loaded    apply it, reading defensively (types, ranges);
//   Missing   a first run: the defaults stay;
//   Rejected  the file could not be read or parsed: it is kept as
//             "settings.json.rejected" (never overwritten), the defaults stay;
//   Error     no config folder, a bad name, or a bad file that could not be
//             moved aside (Save then refuses that name until a Load succeeds).
static SettingsFile ReadSettings() {
    SettingsFile r;
    r.result = p1::Settings::Load(kSettingsFile, r.json, &r.error);
    return r;
}

static void ApplySettingsFile(App& app, const SettingsFile& r) {
    app.settings.loadResult = r.result;
    app.settings.loadError = r.error;
    app.settings.loadedUs = p1::NowUs();
    switch (r.result) {
        case p1::Settings::LoadResult::Loaded:
            app.ApplySettings(r.json);
            break;
        case p1::Settings::LoadResult::Missing:
            break;
        case p1::Settings::LoadResult::Rejected:
            p1::Log(P1_LOG_WARN, "settings.json rejected (%s): kept as settings.json.rejected", r.error.c_str());
            break;
        case p1::Settings::LoadResult::Error:
        default:
            p1::Log(P1_LOG_WARN, "settings.json not loaded: %s", r.error.c_str());
            break;
    }
    app.settings.dirty = false;
})p1snip" },
{ "snapshot", "src/lessons/Common.cpp", "GameDataGap()", 20,
R"p1snip(// Why can't the snapshot serve this demo right now? Test the flags in this
// order: the earliest missing step is the one the user can act on.
std::optional<ui::Status> GameDataGap(const P1Snapshot& s, Need need) {
    using ui::Tone;
    if (s.flags == 0)
        return ui::Status{ Tone::Warn, "No game data yet: the snapshot's flags are 0 (the app is not attached "
                                       "to the game, or this is the very first callback)." };
    if (s.flags & P1_SNAP_WGC_MODE)
        return ui::Status{ Tone::Info, "Visual (WGC) mode: P1_SNAP_WGC_MODE is on, so the app reads no game "
                                       "memory and the snapshot carries no game data." };
    if (s.flags & P1_SNAP_ATTACHING)
        return ui::Status{ Tone::Info, "Attaching: P1_SNAP_ATTACHING is on, the app's first scan of the game "
                                       "is still running." };
    if (!(s.flags & P1_SNAP_ATTACHED))
        return ui::Status{ Tone::Warn, "Not attached: P1_SNAP_ATTACHED is off. Start the game; the app finds "
                                       "it on its own." };
    if (need == Need::Attached) return std::nullopt;
    if (!(s.flags & P1_SNAP_IN_GAME))
        return Reason(Tone::Info, "Not in game: P1_SNAP_IN_GAME is off (game state: %s). Enter an area.",
                      StateName(s.game_state));
    if (need == Need::Camera && !(s.flags & P1_SNAP_CAMERA_VALID))
        return ui::Status{ Tone::Info, "No camera: P1_SNAP_CAMERA_VALID is off this tick, so world positions "
                                       "cannot be projected to the screen." };
    return std::nullopt;
})p1snip" },
{ "style", "src/ui/Ui.cpp", "ToneColor()", 134,
R"p1snip(// The ONLY colours this plugin defines itself. Everything else comes from the
