<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    ExamplePlugin.dll - "SDK Example", the guided tour of the POE1Fixer plugin SDK. A plugin project needs:
      * the SDK include dirs (PluginSDK\include for <p1sdk/...>, PluginSDK\imgui for imgui.h),
      * the SDK's pinned ImGui core sources compiled INTO the DLL (imgui*.cpp, no backends),
      * /W4-clean code of its own; the vendored ImGui TUs build with warnings off,
      * plugin.json next to the DLL (the post-build step copies it).
    This project also adds src\ to the include path (its own headers) and defines NOMINMAX.
    src\generated\Snippets.inc is generated by tools\gen_snippets.py and committed, so a build
    needs no Python; run "python tools\gen_snippets.py" after editing a snippet block.
    Output: x64\<Configuration>\Plugins\ExamplePlugin\ - copy that folder into <app dir>\Plugins\.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Dbg|x64">
      <Configuration>Dbg</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{E1F2A3B4-C5D6-7E80-9F1A-2B3C4D5E6F70}</ProjectGuid>
    <RootNamespace>ExamplePlugin</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>ExamplePlugin</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Dbg'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>ExamplePlugin</TargetName>
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\Plugins\ExamplePlugin\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(SolutionDir)PluginSDK\include;$(SolutionDir)PluginSDK\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- A PDB in Release too: keep the PDB of every build you ship, so a crash dump from a
           user can be read. /PDBALTPATH:%_PDB% records only the PDB's file name in the DLL, never
           the absolute path of the build machine. /DEBUG would turn reference elimination and
           COMDAT folding off; Release keeps both on. -->
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
    </Link>
    <PostBuildEvent>
      <Command>copy /Y "$(ProjectDir)plugin.json" "$(OutDir)plugin.json" &gt;nul</Command>
      <Message>Copying plugin.json next to the plugin DLL</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Plugin.cpp" />
    <ClCompile Include="src\App.cpp" />
    <ClCompile Include="src\Shell.cpp" />
    <ClCompile Include="src\Names.cpp" />
    <ClCompile Include="src\Snippets.cpp" />
    <ClCompile Include="src\Util.cpp" />
    <ClCompile Include="src\ui\Ui.cpp" />
    <ClCompile Include="src\lessons\Common.cpp" />
    <ClCompile Include="src\lessons\Registry.cpp" />
    <ClCompile Include="src\lessons\Lifecycle.cpp" />
    <ClCompile Include="src\lessons\Events.cpp" />
    <ClCompile Include="src\lessons\Logging.cpp" />
    <ClCompile Include="src\lessons\Settings.cpp" />
    <ClCompile Include="src\lessons\Language.cpp" />
    <ClCompile Include="src\lessons\Snapshot.cpp" />
    <ClCompile Include="src\lessons\Player.cpp" />
    <ClCompile Include="src\lessons\Area.cpp" />
    <ClCompile Include="src\lessons\Entities.cpp" />
    <ClCompile Include="src\lessons\Buffs.cpp" />
    <ClCompile Include="src\lessons\Inventory.cpp" />
    <ClCompile Include="src\lessons\MapUi.cpp" />
    <ClCompile Include="src\lessons\Overlay.cpp" />
    <ClCompile Include="src\lessons\WorldToScreen.cpp" />
    <ClCompile Include="src\lessons\Textures.cpp" />
    <ClCompile Include="src\lessons\Widgets.cpp" />
    <ClCompile Include="src\lessons\Style.cpp" />
    <ClCompile Include="src\lessons\Keyboard.cpp" />
    <ClCompile Include="src\lessons\Input.cpp" />
    <ClCompile Include="src\lessons\Clipboard.cpp" />
    <ClCompile Include="src\lessons\Memory.cpp" />
    <ClCompile Include="src\lessons\Performance.cpp" />
    <ClCompile Include="src\lessons\Threads.cpp" />
    <!-- The SDK's pinned ImGui core: warnings off (vendored, does not pass /W4 clean). -->
    <ClCompile Include="..\..\PluginSDK\imgui\imgui.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\PluginSDK\imgui\imgui_draw.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\PluginSDK\imgui\imgui_tables.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\PluginSDK\imgui\imgui_widgets.cpp">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\PluginSDK\include\p1sdk\p1sdk.hpp" />
    <ClInclude Include="..\..\PluginSDK\include\p1sdk\p1_abi.h" />
    <ClInclude Include="..\..\PluginSDK\include\p1sdk\p1_snapshot.h" />
    <ClInclude Include="src\App.h" />
    <ClInclude Include="src\JsonUtil.h" />
    <ClInclude Include="src\Names.h" />
    <ClInclude Include="src\Shell.h" />
    <ClInclude Include="src\Snippets.h" />
    <ClInclude Include="src\Util.h" />
    <ClInclude Include="src\ui\Ui.h" />
    <ClInclude Include="src\lessons\Common.h" />
    <ClInclude Include="src\lessons\Lesson.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.json" />
    <None Include="README.md" />
    <None Include="src\generated\Snippets.inc" />
    <None Include="tools\gen_snippets.py" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
